<Window x:Class="NanairoWorkReportTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:NanairoWorkReportTool.Core.Domain;assembly=NanairoWorkReportTool.Core"
        Title="ナナイロ作業報告入力ツール" Width="1500" Height="930" MinWidth="1100" MinHeight="720"
        Background="#F3F4F6" AllowDrop="True" Loaded="Window_Loaded" Closing="Window_Closing" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="NormalOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.Normal}">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CompanyHolidayOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsEnabled" Value="False"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.CompanyHoliday}">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="190"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111827" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                        <Button Content="新規作成" Command="{Binding NewCommand}"/>
                        <Button Content="ファイルを開く" Command="{Binding OpenCommand}"/>
                        <Button Content="保存 (.nwr)" Command="{Binding SaveCommand}"/>
                        <Button Content="チェック" Command="{Binding CheckCommand}" Background="#DBEAFE"/>
                        <Button Content="Excel出力" Command="{Binding ExportExcelCommand}" Background="#DCFCE7"/>
                        <Button Content="PDF出力" Command="{Binding ExportPdfCommand}" Background="#FEE2E2"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <ComboBox Width="260" ItemsSource="{Binding RecentFiles}" x:Name="RecentFilesCombo" ToolTip="最近使用したファイル"/>
                        <Button Content="最近のファイルを開く" Command="{Binding OpenRecentCommand}" CommandParameter="{Binding SelectedItem, ElementName=RecentFilesCombo}"/>
                        <Button Content="祝日情報更新" Command="{Binding UpdateHolidaysCommand}"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Margin="4,8,4,0" Padding="8,4" CornerRadius="5"
                        HorizontalAlignment="Stretch" ToolTip="{Binding DocumentStatePath}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#DCFCE7"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDocumentStateAttention}" Value="True">
                                    <Setter Property="Background" Value="#FEF3C7"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding DocumentStateText}" HorizontalAlignment="Center"
                               Foreground="#111827" FontWeight="SemiBold"/>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="8,8,8,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="入力月 (yyyy/MM)" FontWeight="SemiBold"/>
                    <DockPanel>
                        <TextBox Text="{Binding TargetMonthText, UpdateSourceTrigger=PropertyChanged}" Width="110"/>
                        <Button Content="月を生成" Command="{Binding ApplyMonthCommand}" Padding="8,5"/>
                    </DockPanel>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="入力者名" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Document.ReporterName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="会社名" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Document.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3">
                    <TextBlock Text="提出先" FontWeight="SemiBold"/>
                    <TextBox Text="{Binding Document.Destination, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="保存先" FontWeight="SemiBold"/>
                    <DockPanel>
                        <TextBox Text="{Binding Document.OutputDirectory, UpdateSourceTrigger=PropertyChanged}" MinWidth="260"/>
                        <Button Content="選択" Command="{Binding BrowseOutputDirectoryCommand}" Padding="8,5"/>
                        <Button Content="開く" Command="{Binding OpenOutputDirectoryCommand}" Padding="8,5"/>
                    </DockPanel>
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Grid.Row="2" Columns="10" Margin="8,0,8,4">
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="平日稼働日" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.WeekdayWorkDays, StringFormat={}{0}日}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="公休日" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.CompanyHolidayDays, StringFormat={}{0}日}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="有給休暇" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.PaidLeaveDays, StringFormat={}{0}日}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="基準工数" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.BaselineHours, StringFormat={}{0:0.##}h}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="下限 / 上限" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.LowerHours, StringFormat={}{0:0.##}h}" FontSize="16" FontWeight="Bold"/><TextBlock Text="{Binding Summary.UpperHours, StringFormat={}{0:0.##}h}"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="当日まで" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.ActualToDateHours, StringFormat={}{0:0.##}h}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="月末見込み" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.ForecastHours, StringFormat={}{0:0.##}h}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="下限までの余裕" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.LowerBufferHours, StringFormat={}{0:0.##}h}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="有給取得目安" Foreground="#6B7280"/><TextBlock Text="{Binding Summary.AvailablePaidLeaveDays, StringFormat={}{0}日}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
            <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="精算幅" Foreground="#6B7280"/><TextBlock Text="{Binding SettlementStatus}" FontSize="20" FontWeight="Bold"/></StackPanel></Border>
        </UniformGrid>

        <Grid Grid.Row="3" Margin="8,0,8,4">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Background="White">
                <TextBlock Text="日別入力一覧（Ctrl/Shiftで複数日を選択）" FontWeight="Bold" VerticalAlignment="Center" Margin="8"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ComboBox x:Name="BulkStatusCombo" Width="115" ItemsSource="{Binding WorkStatusOptions}" DisplayMemberPath="DisplayName" SelectedValuePath="Value" ToolTip="選択した日へ一括設定する勤務区分"/>
                    <Button Content="区分を一括設定" Click="BulkStatus_Click"/>
                    <ComboBox x:Name="BulkContentCombo" Width="180" ItemsSource="{Binding WorkContentHistory}" IsEditable="True" IsTextSearchEnabled="True" ToolTip="直近20件から選ぶか入力"/>
                    <Button Content="作業内容を一括設定" Click="BulkContent_Click"/>
                    <TextBox x:Name="BulkHolidayNameText" Width="105" ToolTip="公休日名"/>
                    <Button Content="公休日を一括設定" Click="BulkHoliday_Click"/>
                    <Button Content="標準時間へ" Click="StandardTime_Click"/>
                    <Button Content="時間クリア" Click="ClearTime_Click"/>
                    <Button Content="前日の作業内容をコピー" Click="CopyPrevious_Click"/>
                </StackPanel>
            </DockPanel>
            <DataGrid Grid.Row="1" x:Name="EntriesGrid" ItemsSource="{Binding Document.Entries}" AutoGenerateColumns="False"
                      CanUserAddRows="False" CanUserDeleteRows="False" PreviewKeyDown="EntriesGrid_PreviewKeyDown"
                      SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="54"
                      HeadersVisibility="Column" GridLinesVisibility="All" FrozenColumnCount="4">
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="White"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding DayType}" Value="{x:Static core:DayType.Saturday}"><Setter Property="Background" Value="#E0F2FE"/></DataTrigger>
                            <DataTrigger Binding="{Binding DayType}" Value="{x:Static core:DayType.Sunday}"><Setter Property="Background" Value="#FEE2E2"/></DataTrigger>
                            <DataTrigger Binding="{Binding DayType}" Value="{x:Static core:DayType.Holiday}"><Setter Property="Background" Value="#FEF3C7"/></DataTrigger>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.CompanyHoliday}"><Setter Property="Background" Value="#E5E7EB"/></DataTrigger>
                            <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.PaidLeave}"><Setter Property="Background" Value="#F3E8FF"/></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="日付" Binding="{Binding DateDisplay}" IsReadOnly="True" Width="65"/>
                    <DataGridTextColumn Header="曜" Binding="{Binding DayOfWeekDisplay}" IsReadOnly="True" Width="42"/>
                    <DataGridTextColumn Header="日種別" Binding="{Binding DayTypeDisplay}" IsReadOnly="True" Width="115"/>
                    <DataGridTextColumn Header="状態" Binding="{Binding WorkStatusIcon}" IsReadOnly="True" Width="48"/>
                    <DataGridTemplateColumn Header="勤務区分" Width="120">
                        <DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <ComboBox ItemsSource="{Binding DataContext.WorkStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding WorkStatus, Mode=TwoWay}"/>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="作業内容" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                        <TextBox Style="{StaticResource NormalOnlyTextBox}" Text="{Binding WorkContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="開始" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource NormalOnlyTextBox}" Text="{Binding StartTimeText, UpdateSourceTrigger=LostFocus}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="終了" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource NormalOnlyTextBox}" Text="{Binding EndTimeText, UpdateSourceTrigger=LostFocus}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="総稼働" Binding="{Binding GrossHoursDisplay}" IsReadOnly="True" Width="72"/>
                    <DataGridTemplateColumn Header="休憩(h)" Width="76"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource NormalOnlyTextBox}" Text="{Binding BreakHoursText, UpdateSourceTrigger=LostFocus}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTextColumn Header="工数(h)" Binding="{Binding WorkHoursDisplay}" IsReadOnly="True" Width="72"/>
                    <DataGridTemplateColumn Header="公休日名" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CompanyHolidayOnlyTextBox}" Text="{Binding CompanyHolidayName, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="備考" Width="170"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="8,0,8,4">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel>
                    <TextBlock Text="チェック結果" FontSize="16" FontWeight="Bold"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ErrorCount, StringFormat=エラー {0}件}" Foreground="{StaticResource ErrorBrush}" FontWeight="Bold" Margin="8,0"/>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding WarningCount, StringFormat=警告 {0}件}" Foreground="{StaticResource WarningBrush}" FontWeight="Bold"/>
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="ValidationGrid" ItemsSource="{Binding ValidationIssues}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" MouseDoubleClick="ValidationGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="種別" Binding="{Binding SeverityDisplay}" Width="80"/>
                        <DataGridTextColumn Header="日付" Binding="{Binding DateDisplay}" Width="100"/>
                        <DataGridTextColumn Header="項目" Binding="{Binding Field}" Width="130"/>
                        <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="5" Background="White" Padding="8">
            <DockPanel>
                <ProgressBar DockPanel.Dock="Right" Width="160" Height="12" IsIndeterminate="True" Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                <TextBlock Text="  ● 未保存" Foreground="#DC2626" FontWeight="Bold" VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBlock DockPanel.Dock="Right" Text="{Binding LeaveGuidance}" FontWeight="SemiBold" Foreground="#1D4ED8" Margin="12,0"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
