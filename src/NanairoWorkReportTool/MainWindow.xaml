<Window x:Class="NanairoWorkReportTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:NanairoWorkReportTool.Core.Domain;assembly=NanairoWorkReportTool.Core"
        Title="ナナイロ ワークレポート" Width="1540" Height="940" MinWidth="1180" MinHeight="760"
        Background="{StaticResource CanvasBrush}" AllowDrop="True"
        Loaded="Window_Loaded" Closing="Window_Closing" Drop="Window_Drop">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource SurfaceBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="1,0,0,6"/>
        </Style>

        <Style x:Key="MetricLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>

        <Style x:Key="MetricValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="NormalOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.Normal}">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompanyHolidayOnlyTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsEnabled" Value="False"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.CompanyHoliday}">
                    <Setter Property="IsEnabled" Value="True"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GridEditorTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="Padding" Value="7,4"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="74"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="154"/>
            <RowDefinition Height="34"/>
        </Grid.RowDefinitions>

        <!-- Product header and primary actions -->
        <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="20,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentBrush}" Margin="0,0,12,0">
                        <TextBlock Text="N" Foreground="White" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="ナナイロ ワークレポート" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="●" Foreground="{StaticResource ErrorBrush}" FontSize="9" Margin="9,2,0,0"
                                       VerticalAlignment="Center" Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"
                                       ToolTip="未保存の変更があります"/>
                        </StackPanel>
                        <TextBlock Text="{Binding DocumentStateText}" FontSize="12" Margin="0,3,0,0" ToolTip="{Binding DocumentStatePath}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDocumentStateAttention}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="＋  新規" Command="{Binding NewCommand}" Style="{StaticResource SubtleButton}" Margin="0,0,4,0"/>
                    <Button Content="開く" Command="{Binding OpenCommand}" Style="{StaticResource SubtleButton}" Margin="0,0,4,0"/>
                    <Button Content="保存" Command="{Binding SaveCommand}" Margin="0,0,16,0"/>
                    <Border Width="1" Height="26" Background="{StaticResource BorderBrush}" Margin="0,0,16,0"/>
                    <Button Content="チェック" Command="{Binding CheckCommand}" Margin="0,0,8,0"/>
                    <Button Content="Excel 出力" Command="{Binding ExportExcelCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/>
                    <Button Content="PDF 出力" Command="{Binding ExportPdfCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Report settings -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="16,14,16,0" Padding="14,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0,0,0,10" LastChildFill="False">
                    <TextBlock Text="レポート設定" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="最近のファイル" Style="{StaticResource FieldLabel}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <ComboBox Width="220" MinHeight="30" x:Name="RecentFilesCombo" ItemsSource="{Binding RecentFiles}"
                                  ToolTip="最近使用したファイル" Margin="0,0,6,0"/>
                        <Button Content="開く" Command="{Binding OpenRecentCommand}"
                                CommandParameter="{Binding SelectedItem, ElementName=RecentFilesCombo}"
                                Style="{StaticResource CompactButton}" Margin="0,0,8,0"/>
                        <Button Content="祝日情報を更新" Command="{Binding UpdateHolidaysCommand}"
                                Style="{StaticResource SubtleButton}" Padding="9,4" MinHeight="30"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.05*"/>
                        <ColumnDefinition Width="1.2*"/>
                        <ColumnDefinition Width="2.2*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,14,0">
                        <TextBlock Text="対象月" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding TargetMonthText, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="生成" Command="{Binding ApplyMonthCommand}"
                                    Style="{StaticResource CompactButton}" Margin="6,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="入力者名" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Document.ReporterName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,14,0">
                        <TextBlock Text="会社名" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Document.CompanyName, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,14,0">
                        <TextBlock Text="提出先" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding Document.Destination, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="保存先" Style="{StaticResource FieldLabel}"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding Document.OutputDirectory, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Grid.Column="1" Content="選択" Command="{Binding BrowseOutputDirectoryCommand}"
                                    Style="{StaticResource CompactButton}" Margin="6,0,0,0"/>
                            <Button Grid.Column="2" Content="開く" Command="{Binding OpenOutputDirectoryCommand}"
                                    Style="{StaticResource SubtleButton}" Padding="9,4" MinHeight="30" Margin="2,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- Calm, grouped monthly summary -->
        <Grid Grid.Row="2" Margin="16,10,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="稼働日" Style="{StaticResource MetricLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Summary.WeekdayWorkDays, StringFormat={}{0}日}" Style="{StaticResource MetricValue}"/>
                        <TextBlock Text="  公休 " Foreground="{StaticResource TextSecondaryBrush}" Margin="12,7,0,0"/>
                        <TextBlock Text="{Binding Summary.CompanyHolidayDays, StringFormat={}{0}日}" FontWeight="SemiBold" Margin="0,7,0,0"/>
                        <TextBlock Text="  有給 " Foreground="{StaticResource TextSecondaryBrush}" Margin="10,7,0,0"/>
                        <TextBlock Text="{Binding Summary.PaidLeaveDays, StringFormat={}{0}日}" FontWeight="SemiBold" Margin="0,7,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="時間レンジ" Style="{StaticResource MetricLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Summary.BaselineHours, StringFormat={}{0:0.##}h}" Style="{StaticResource MetricValue}"/>
                        <StackPanel Margin="14,1,0,0">
                            <TextBlock Text="下限 / 上限" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock FontWeight="SemiBold">
                                <Run Text="{Binding Summary.LowerHours, Mode=OneWay, StringFormat={}{0:0.##}}"/><Run Text=" / "/><Run Text="{Binding Summary.UpperHours, Mode=OneWay, StringFormat={}{0:0.##}h}"/>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="今月の見込み" Style="{StaticResource MetricLabel}"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Summary.ForecastHours, StringFormat={}{0:0.##}h}" Style="{StaticResource MetricValue}"/>
                        <StackPanel Margin="14,1,0,0">
                            <TextBlock Text="当日まで" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                            <TextBlock Text="{Binding Summary.ActualToDateHours, StringFormat={}{0:0.##}h}" FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="精算" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding SettlementStatus}" Style="{StaticResource MetricValue}" Foreground="{StaticResource AccentBrush}"/>
                    <TextBlock Text="{Binding Summary.LowerBufferHours, StringFormat=下限まで {0:0.##}h}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="14,11">
                <StackPanel>
                    <TextBlock Text="有給取得の目安" Style="{StaticResource MetricLabel}"/>
                    <TextBlock Text="{Binding Summary.AvailablePaidLeaveDays, StringFormat={}{0}日}" Style="{StaticResource MetricValue}"/>
                    <TextBlock Text="現在の工数から算出" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Daily entry workspace -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="16,0,16,10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48"/>
                    <RowDefinition Height="46"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="14,0" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="日別入力" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="複数日は Ctrl / Shift で選択" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="12,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="前日からコピー" Click="CopyPrevious_Click" Style="{StaticResource SubtleButton}" Padding="9,4" MinHeight="30" Margin="0,0,2,0"/>
                        <Button Content="標準時間" Click="StandardTime_Click" Style="{StaticResource SubtleButton}" Padding="9,4" MinHeight="30" Margin="0,0,2,0"/>
                        <Button Content="時間をクリア" Click="ClearTime_Click" Style="{StaticResource SubtleButton}" Padding="9,4" MinHeight="30"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{StaticResource SurfaceMutedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,1">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Margin="14,6">
                            <TextBlock Text="一括設定" Foreground="{StaticResource TextSecondaryBrush}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox x:Name="BulkStatusCombo" Width="118" MinHeight="30" ItemsSource="{Binding WorkStatusOptions}"
                                      DisplayMemberPath="DisplayName" SelectedValuePath="Value" ToolTip="選択した日へ設定する勤務区分"/>
                            <Button Content="区分を適用" Click="BulkStatus_Click" Style="{StaticResource CompactButton}" Margin="5,0,14,0"/>
                            <ComboBox x:Name="BulkContentCombo" Width="210" MinHeight="30" ItemsSource="{Binding WorkContentHistory}"
                                      IsEditable="True" IsTextSearchEnabled="True" ToolTip="直近20件から選ぶか入力"/>
                            <Button Content="作業内容を適用" Click="BulkContent_Click" Style="{StaticResource CompactButton}" Margin="5,0,14,0"/>
                            <TextBox x:Name="BulkHolidayNameText" Width="130" MinHeight="30" Padding="7,4" ToolTip="公休日名"/>
                            <Button Content="公休日を適用" Click="BulkHoliday_Click" Style="{StaticResource CompactButton}" Margin="5,0,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <DataGrid Grid.Row="2" x:Name="EntriesGrid" ItemsSource="{Binding Document.Entries}" AutoGenerateColumns="False"
                          CanUserAddRows="False" CanUserDeleteRows="False" PreviewKeyDown="EntriesGrid_PreviewKeyDown"
                          SelectionMode="Extended" SelectionUnit="FullRow" RowHeight="49" FrozenColumnCount="4">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding DayType}" Value="{x:Static core:DayType.Saturday}"><Setter Property="Background" Value="#F3F8FC"/></DataTrigger>
                                <DataTrigger Binding="{Binding DayType}" Value="{x:Static core:DayType.Sunday}"><Setter Property="Background" Value="#FCF5F6"/></DataTrigger>
                                <DataTrigger Binding="{Binding DayType}" Value="{x:Static core:DayType.Holiday}"><Setter Property="Background" Value="#FFF9E9"/></DataTrigger>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.CompanyHoliday}"><Setter Property="Background" Value="#F2F4F6"/></DataTrigger>
                                <DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.PaidLeave}"><Setter Property="Background" Value="#F8F4FC"/></DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#F1F6FB"/></Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" Value="#E4F0FA"/>
                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="日付" Binding="{Binding DateDisplay}" IsReadOnly="True" Width="64"/>
                        <DataGridTextColumn Header="曜" Binding="{Binding DayOfWeekDisplay}" IsReadOnly="True" Width="42"/>
                        <DataGridTextColumn Header="日種別" Binding="{Binding DayTypeDisplay}" IsReadOnly="True" Width="92"/>
                        <DataGridTextColumn Header="状態" Binding="{Binding WorkStatusIcon}" IsReadOnly="True" Width="46"/>
                        <DataGridTemplateColumn Header="勤務区分" Width="118">
                            <DataGridTemplateColumn.CellTemplate><DataTemplate>
                                <ComboBox MinHeight="32" ItemsSource="{Binding DataContext.WorkStatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="Value" SelectedValue="{Binding WorkStatus, Mode=TwoWay}"/>
                            </DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="作業内容" Width="*" MinWidth="260"><DataGridTemplateColumn.CellTemplate><DataTemplate>
                            <TextBox Text="{Binding WorkContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" MinHeight="32" Padding="7,4">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource GridEditorTextBox}">
                                        <Setter Property="IsEnabled" Value="False"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding WorkStatus}" Value="{x:Static core:WorkStatus.Normal}"><Setter Property="IsEnabled" Value="True"/></DataTrigger></Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="開始" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource NormalOnlyTextBox}" MinHeight="32" Padding="6,4" Text="{Binding StartTimeText, UpdateSourceTrigger=LostFocus}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="終了" Width="72"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource NormalOnlyTextBox}" MinHeight="32" Padding="6,4" Text="{Binding EndTimeText, UpdateSourceTrigger=LostFocus}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="総稼働" Binding="{Binding GrossHoursDisplay}" IsReadOnly="True" Width="68"/>
                        <DataGridTemplateColumn Header="休憩" Width="68"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource NormalOnlyTextBox}" MinHeight="32" Padding="6,4" Text="{Binding BreakHoursText, UpdateSourceTrigger=LostFocus}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="工数" Binding="{Binding WorkHoursDisplay}" IsReadOnly="True" Width="64"/>
                        <DataGridTemplateColumn Header="公休日名" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource CompanyHolidayOnlyTextBox}" MinHeight="32" Padding="6,4" Text="{Binding CompanyHolidayName, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="備考" Width="160"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Style="{StaticResource GridEditorTextBox}" Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Validation is visually secondary until it needs attention -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="16,0,16,10" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="14,0" LastChildFill="False">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="チェック結果" FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock Text="行をダブルクリックすると該当日に移動します" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="12,2,0,0"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource WarningSoftBrush}" CornerRadius="12" Padding="9,3" Margin="0,0,6,0">
                            <TextBlock Text="{Binding WarningCount, StringFormat=警告 {0}}" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                        <Border Background="{StaticResource ErrorSoftBrush}" CornerRadius="12" Padding="9,3">
                            <TextBlock Text="{Binding ErrorCount, StringFormat=エラー {0}}" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </DockPanel>
                <DataGrid Grid.Row="1" x:Name="ValidationGrid" ItemsSource="{Binding ValidationIssues}" AutoGenerateColumns="False"
                          CanUserAddRows="False" IsReadOnly="True" RowHeight="32" MouseDoubleClick="ValidationGrid_MouseDoubleClick"
                          BorderThickness="0,1,0,0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="種別" Binding="{Binding SeverityDisplay}" Width="72"/>
                        <DataGridTextColumn Header="日付" Binding="{Binding DateDisplay}" Width="88"/>
                        <DataGridTextColumn Header="項目" Binding="{Binding Field}" Width="120"/>
                        <DataGridTextColumn Header="内容" Binding="{Binding Message}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Quiet status bar -->
        <Border Grid.Row="5" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0" LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                    <TextBlock Text="  •  未保存" Foreground="{StaticResource ErrorBrush}" FontWeight="SemiBold" FontSize="12"
                               Visibility="{Binding IsDirty, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding LeaveGuidance}" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,0,14,0"/>
                    <ProgressBar Width="120" Height="4" IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
